# Copy to `.env` for local development. Every value here is a placeholder
# for a database on your own machine. Real values never go in this file.

# Where this runs: `development` or `production`. There is no default for
# the API, the worker and the mock. In production the mock refuses to
# start; the API and the worker refuse the mock as the channel, any secret
# that carries the mark `local-only` (every placeholder below does but the
# database administrator's; the mark is a net for a copied file, not a
# test of a secret), and, the
# worker, one channel credential for every tenant. The operator's commands
# and the database tool do not read this setting.
PSA_ENV=development

# The server's administrator. Used once, by `make db-setup`, to create the
# three roles. Nothing else connects with it.
PSA_DB_ADMIN_URL=postgres://postgres:postgres@127.0.0.1:5432/psa

# Passwords `make db-setup` gives the three roles (ADR 0003).
PSA_DB_MIGRATE_PASSWORD=local-only-migrate
PSA_DB_APP_PASSWORD=local-only-app
PSA_DB_CROSS_PASSWORD=local-only-cross

# What migrations connect with.
PSA_DB_MIGRATE_URL=postgres://psa_migrate:local-only-migrate@127.0.0.1:5432/psa

# What the worker's readiness probe connects with (`pnpm run db worker-status`).
PSA_DB_CROSS_URL=postgres://psa_cross:local-only-cross@127.0.0.1:5432/psa

# The API (`node --env-file=.env apps/api/src/main.ts`). It listens on this
# machine unless PSA_API_HOST says otherwise. PSA_TRUSTED_PROXIES lists the
# addresses of the proxies in front of it, separated by commas; leave it
# empty when there is none. See `docs/design/api.md`, section 3, for what a
# wrong value costs.
PSA_API_PORT=3000
PSA_DB_APP_URL=postgres://psa_app:local-only-app@127.0.0.1:5432/psa
PSA_WHATSAPP_VERIFY_TOKEN=local-only-verify-value
PSA_WHATSAPP_BASE_URL=http://127.0.0.1:4010
PSA_WHATSAPP_API_VERSION=v27.0
PSA_TRUSTED_PROXIES=

# The operator's commands (`pnpm run ops tenant list --as <your name>`) read
# PSA_DB_CROSS_URL above. The two `profile` commands, which load and show a
# tenant's services, policies and settings, read PSA_DB_APP_URL as well: the
# cross-tenant role may not touch a tenant's profile.

# The worker (`node --env-file=.env apps/worker/src/main.ts`). It reads the
# two database URLs, the WhatsApp base URL, API version and app secret
# above and below, and this: the credential it sends with. One for every
# tenant until per-tenant credentials are built; locally it must equal
# PSA_MOCK_ACCESS_TOKEN.
PSA_WHATSAPP_ACCESS_TOKEN=local-only-mock-token

# The mock that stands in for WhatsApp in development
# (`node --env-file=.env apps/mock-whatsapp/src/main.ts`). The first value
# signs the webhooks it sends; the product must be given the same one.
PSA_WHATSAPP_APP_SECRET=local-only-app-signing-value
PSA_MOCK_ACCESS_TOKEN=local-only-mock-token
PSA_MOCK_PORT=4010
# PSA_MOCK_HOST may be set to 0.0.0.0 so that the mock listens on every
# interface. That is for a container whose port is published to this
# machine only, as `docker-compose.yml` does. Anywhere else it lets anyone
# who can reach the machine send messages as any customer. Leave it unset.
PSA_MOCK_WEBHOOK_URL=http://127.0.0.1:3000/webhooks/whatsapp

# What the tests connect with. They create and drop their own databases.
PSA_TEST_ADMIN_URL=postgres://postgres:postgres@127.0.0.1:5432/postgres
